# Salin file ini menjadi .env lalu isi dari Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key
VITE_MEDIA_STORAGE_ENABLED=false

# Hanya untuk menjalankan `npm run migrate:media`; jangan gunakan prefix VITE_.
# Jangan pernah commit atau kirim service role key ke browser.
SUPABASE_SERVICE_ROLE_KEY=
